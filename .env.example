# --- PaintIt : variables d'environnement de production ---
# Copiez en .env (ou exportez dans votre orchestrateur) et adaptez.

# Coeur Django
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=changez-moi-avec-une-cle-longue-et-aleatoire-64+car
DJANGO_ALLOWED_HOSTS=paintit.com,www.paintit.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://paintit.com,https://www.paintit.com
SITE_URL=https://paintit.com
DJANGO_SSL_REDIRECT=1
# DJANGO_LOG_LEVEL=INFO

# Base de donnees (Postgres recommande en prod ; sinon SQLite par defaut)
# DATABASE_URL=postgres://user:pass@host:5432/paintit

# Cache partage entre workers (OBLIGATOIRE en multi-worker pour la barre de
# progression de generation). Sans Redis, chaque worker a son cache local.
# REDIS_URL=redis://localhost:6379/0

# Fichiers media persistants (uploads + dossiers de commande)
# MEDIA_ROOT=/var/lib/paintit/media

# Paiement Stripe (webhook a configurer sur https://SITE/webhooks/stripe/)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Fournisseur OEM (dropshipping) : e-mail de bon de commande apres onboarding
SUPPLIER_NAME=VANCY ARTS (OEM, Yiwu)
SUPPLIER_ORDER_EMAIL=
# ou API : SUPPLIER_API_URL=... SUPPLIER_API_TOKEN=...

# E-mail sortant (confirmations client + PO fournisseur)
EMAIL_HOST=smtp.exemple.com
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=xxx
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=PaintIt <no-reply@paintit.com>
SUPPORT_EMAIL=contact@paintit.com
