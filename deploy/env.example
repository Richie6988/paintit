# Configuration de production PaintIt : copier en /home/paintit/Django/.env puis remplir.
# Lu automatiquement par Django (site, cron, commandes). Ne jamais le commiter.
#   cp deploy/env.example .env && nano .env && chmod 600 .env && systemctl restart paintit

# --- Coeur (obligatoire) ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=            # python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_ALLOWED_HOSTS=paintit.click,www.paintit.click
SITE_URL=https://paintit.click
DJANGO_ADMINS=Prenom:vous@exemple.com   # recoit les erreurs 500 par e-mail

# --- Paiement Stripe (cles LIVE) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- E-mails (SMTP) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PaintIt <contact@paintit.click>
SERVER_EMAIL=alertes@paintit.click

# --- Options ---
INDEXNOW_KEY=                 # python -c "import secrets;print(secrets.token_hex(16))"  (32 caracteres hexa)
AFTERSHIP_API_KEY=            # suivi colis + e-mail « ça arrive »
BACKUP_DIR=/home/paintit/backups
BACKUP_KEEP=14
# DJANGO_HSTS_SECONDS=31536000  (defaut ; 0 pour desactiver)
